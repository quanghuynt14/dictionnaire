{"id": "fr:sonner", "by": "claude", "added": "2026-11-27", "add_blocks": [{"pos": "verb", "pos_vi": "Động từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Kêu, reo, vang; điểm (giờ).", "sub": [], "tags": [], "examples": [{"src": "Dix heures venaient de sonner à la vieille horloge.", "tr": "Chiếc đồng hồ cũ vừa điểm mười giờ."}]}, {"gloss": "Rung (chuông), gióng, thổi (kèn).", "sub": [], "tags": [], "examples": [{"src": "Sonner la cloche.", "tr": "Rung chuông."}, {"src": "Ceci devrait toujours sonner l'alarme.", "tr": "Điều này luôn phải gióng lên hồi chuông cảnh báo."}]}, {"gloss": "Bấm chuông (để gọi người, để được mở cửa).", "sub": [], "tags": [], "examples": [{"src": "Allez ouvrir et faites attendre. Je sonnerai.", "tr": "Ra mở cửa và bảo người ta đợi. Tôi sẽ bấm chuông gọi."}]}, {"gloss": "Nghe có vẻ, nghe như (sonner faux, sonner juste).", "sub": [], "tags": [], "examples": [{"src": "Ses explications sonnaient faux.", "tr": "Lời giải thích của anh ta nghe giả dối."}, {"src": "Et si je voulais sonner comme les Pink Floyd au complet ?", "tr": "Còn nếu tôi muốn nghe giống cả ban Pink Floyd thì sao?"}]}]}], "reason": "Le Wiktionnaire vietnamien n'a pas de page pour « sonner ».", "sources": ["https://fr.wiktionary.org/w/index.php?title=sonner&oldid=39807231", "https://en.wiktionary.org/w/index.php?title=sonner&oldid=86483984"]}
{"id": "fr:cependant", "by": "claude", "added": "2026-11-27", "add_blocks": [{"pos": "adv", "pos_vi": "Phó từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Tuy nhiên, tuy vậy, dù vậy.", "sub": [], "tags": [], "examples": [{"src": "Cependant, il y a des inconvénients.", "tr": "Tuy nhiên, cũng có những nhược điểm."}, {"src": "Cependant, mon état s'est progressivement aggravé.", "tr": "Tuy nhiên, bệnh tình của tôi dần tệ hơn."}]}, {"gloss": "Trong khi đó, trong lúc ấy.", "sub": [], "tags": [], "examples": [{"src": "Nous nous amusons, et cependant la nuit vient.", "tr": "Chúng ta vui chơi, trong khi đó đêm đang xuống."}]}]}], "reason": "Le Wiktionnaire vietnamien n'a pas de page pour « cependant ».", "sources": ["https://fr.wiktionary.org/w/index.php?title=cependant&oldid=39958700", "https://en.wiktionary.org/w/index.php?title=cependant&oldid=92726192"]}
{"id": "fr:frais", "by": "claude", "added": "2026-11-27", "add_blocks": [{"pos": "adj", "pos_vi": "Tính từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Tươi (mới làm, mới hái, chưa hỏng).", "sub": [], "tags": [], "examples": [{"src": "Il est frais mon poisson !", "tr": "Cá của tôi tươi lắm!"}]}, {"gloss": "Mát, mát mẻ, hơi lạnh.", "sub": [], "tags": [], "examples": [{"src": "Une brise fraîche souffla soudain sur mon visage.", "tr": "Một làn gió mát bỗng thổi qua mặt tôi."}]}, {"gloss": "Mới, vừa xảy ra.", "sub": [], "tags": [], "examples": [{"src": "J'aime écouter les nouvelles fraîches du matin.", "tr": "Tôi thích nghe tin tức mới buổi sáng."}]}, {"gloss": "Tươi tắn, khỏe khoắn; tỉnh táo.", "sub": [], "tags": [], "examples": [{"src": "Il vous garde frais.", "tr": "Nó giữ cho bạn tỉnh táo."}]}]}, {"pos": "adv", "pos_vi": "Phó từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Mát, lạnh (il fait frais: trời mát).", "sub": [], "tags": [], "examples": [{"src": "Il fait encore assez frais, la nuit.", "tr": "Ban đêm trời vẫn còn khá lạnh."}]}]}, {"pos": "noun", "pos_vi": "Danh từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Chi phí, phí tổn (thường ở số nhiều: les frais).", "sub": [], "tags": [], "examples": [{"src": "Les frais généraux ont augmenté.", "tr": "Chi phí chung đã tăng."}, {"src": "5 et 44, ce sont nos frais.", "tr": "5 và 44, đó là mức phí của chúng tôi."}]}, {"gloss": "Khí mát, hơi mát.", "sub": [], "tags": [], "examples": [{"src": "Il faisait sur ces hauteurs un frais que le coucher du soleil devait changer en froid piquant.", "tr": "Trên những đỉnh cao này có hơi mát mà hoàng hôn ắt sẽ biến thành cái lạnh buốt."}]}]}], "reason": "Le Wiktionnaire vietnamien n'a pas de page pour « frais ».", "sources": ["https://fr.wiktionary.org/w/index.php?title=frais&oldid=40006474", "https://en.wiktionary.org/w/index.php?title=frais&oldid=91037726"]}
{"id": "fr:nature", "by": "claude", "added": "2026-11-27", "add_blocks": [{"pos": "noun", "pos_vi": "Danh từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Thiên nhiên, tự nhiên, giới tự nhiên.", "sub": [], "tags": [], "examples": [{"src": "Alors, où se trouve la nature ?", "tr": "Vậy thiên nhiên nằm ở đâu?"}, {"src": "Tous les enfants habitent près de la nature.", "tr": "Mọi đứa trẻ đều sống gần thiên nhiên."}]}, {"gloss": "Bản chất, tính chất (của sự vật).", "sub": [], "tags": [], "examples": [{"src": "La science, par nature, est objective.", "tr": "Khoa học, về bản chất, là khách quan."}, {"src": "Le carbone imbrûlé dépend de la nature du combustible.", "tr": "Lượng các-bon không cháy hết phụ thuộc vào tính chất của nhiên liệu."}]}, {"gloss": "Bản tính, tính khí (của một người).", "sub": [], "tags": [], "examples": [{"src": "C'est une nature totalement indépendante et obstinée.", "tr": "Đó là một người có bản tính hoàn toàn độc lập và bướng bỉnh."}]}, {"gloss": "Hiện vật (en nature: bằng hiện vật, không phải bằng tiền).", "sub": [], "tags": [], "examples": [{"src": "C'était l'avantage en nature suprême.", "tr": "Đó là khoản phúc lợi bằng hiện vật hậu hĩnh nhất."}]}]}, {"pos": "adj", "pos_vi": "Tính từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Không thêm gia vị, nguyên vị, trơn (món ăn; không đổi dạng).", "sub": [], "tags": [], "examples": [{"src": "Une brioche nature ou sucrée ?", "tr": "Bánh brioche nguyên vị hay có đường?"}]}, {"gloss": "Tự nhiên, chân chất, không màu mè (người).", "sub": [], "tags": ["familier"], "examples": [{"src": "J'étais très simple, très saine, très « nature ».", "tr": "Tôi rất giản dị, rất lành mạnh, rất « tự nhiên »."}]}]}], "reason": "Le Wiktionnaire vietnamien n'a pas de page pour « nature ».", "sources": ["https://fr.wiktionary.org/w/index.php?title=nature&oldid=39901176", "https://en.wiktionary.org/w/index.php?title=nature&oldid=95674831"]}
