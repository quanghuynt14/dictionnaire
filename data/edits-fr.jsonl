{"id": "fr:qui", "by": "claude", "added": "2026-11-27", "add_blocks": [{"pos": "pron", "pos_vi": "Đại từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Ai (đại từ nghi vấn).", "sub": [], "tags": [], "examples": [{"src": "Tu as vu qui ?", "tr": "Cậu đã gặp ai?"}, {"src": "Et qui dialoguerait avec des terroristes ?", "tr": "Và có ai muốn nói chuyện với các nhóm khủng bố chứ?"}]}, {"gloss": "Mà, người mà, cái mà (đại từ quan hệ, làm chủ ngữ của mệnh đề phụ).", "sub": [], "tags": [], "examples": [{"src": "La personne qui parle connait bien son sujet.", "tr": "Người đang nói hiểu rõ chủ đề của mình."}, {"src": "Nous n'avons pas réalisé ce qui se passait.", "tr": "Chúng ta đã không hiểu những gì xảy ra."}]}, {"gloss": "Người mà (sau giới từ).", "sub": [], "tags": [], "examples": [{"src": "Un homme à qui j’ai parlé.", "tr": "Một người đàn ông mà tôi đã nói chuyện cùng."}]}, {"gloss": "Ai mà, bất cứ ai (không có tiền ngữ).", "sub": [], "tags": [], "examples": [{"src": "C’était un paradis pour qui revenait du lycée.", "tr": "Đó là thiên đường đối với ai đi học về."}]}]}], "reason": "Le Wiktionnaire vietnamien n'a pas de page pour « qui ».", "sources": ["https://fr.wiktionary.org/w/index.php?title=qui&oldid=40003401", "https://en.wiktionary.org/w/index.php?title=qui&oldid=95828906"]}
{"id": "fr:elle", "by": "claude", "added": "2026-11-27", "add_blocks": [{"pos": "pron", "pos_vi": "Đại từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Cô ấy, chị ấy, bà ấy, nó (ngôi thứ ba số ít giống cái, làm chủ ngữ; chỉ người, con vật hoặc đồ vật).", "sub": [], "tags": [], "examples": [{"src": "Je crois qu'elle est partie.", "tr": "Tôi nghĩ cô ấy đã đi rồi."}, {"src": "Voilà ma voiture. Elle a cinq ans.", "tr": "Đây là xe của tôi. Nó đã được năm năm."}, {"src": "Elle est lycéenne.", "tr": "Cô là một học sinh trung học."}]}, {"gloss": "Cô ấy, bà ấy, nó (đại từ nhấn mạnh, sau giới từ hoặc tách khỏi câu); còn cô ấy thì.", "sub": [], "tags": [], "examples": [{"src": "L’Angleterre, elle, a, au début, fait bon accueil à cette proposition.", "tr": "Nước Anh thì ban đầu đã đón nhận đề nghị này."}]}]}], "reason": "Le Wiktionnaire vietnamien n'a pas de page pour « elle ».", "sources": ["https://fr.wiktionary.org/w/index.php?title=elle&oldid=39821966", "https://en.wiktionary.org/w/index.php?title=elle&oldid=95492095"]}
{"id": "fr:ça", "by": "claude", "added": "2026-11-27", "add_blocks": [{"pos": "pron", "pos_vi": "Đại từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Cái đó, cái này, điều đó.", "sub": [], "tags": [], "examples": [{"src": "J'aimerais ça.", "tr": "Tôi muốn cái đó."}, {"src": "Ça aiderait sûrement.", "tr": "Điều đó chắc chắn có ích."}]}, {"gloss": "Nó (chủ ngữ không ngôi hoặc chỉ chung chung; thường không dịch).", "sub": [], "tags": [], "examples": [{"src": "Ça va.", "tr": "Ổn cả."}, {"src": "Ça neige dehors.", "tr": "Ngoài trời đang có tuyết."}, {"src": "Alors, comment ça marche ?", "tr": "Vậy nó vận hành thế nào?"}]}, {"gloss": "(Sau từ nghi vấn, để nhấn mạnh) …thế, …vậy.", "sub": [], "tags": [], "examples": [{"src": "Qui ça, où ça?", "tr": "Ai thế, ở đâu thế?"}]}]}], "reason": "Le Wiktionnaire vietnamien n'a pas de page pour « ça ».", "sources": ["https://fr.wiktionary.org/w/index.php?title=%C3%A7a&oldid=40060529", "https://en.wiktionary.org/w/index.php?title=%C3%A7a&oldid=95371910"]}
{"id": "fr:du", "by": "claude", "added": "2026-11-27", "add_blocks": [{"pos": "article", "pos_vi": "Mạo từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Một ít, một chút (mạo từ bộ phận, trước danh từ giống đực không đếm được; thường không dịch).", "sub": [], "tags": [], "examples": [{"src": "Il faut boire du lait tous les jours.", "tr": "Phải uống sữa mỗi ngày."}, {"src": "Il mange du pain.", "tr": "Anh ấy ăn bánh mì."}]}, {"gloss": "(faire du…) Chơi, tập (một môn, một hoạt động).", "sub": [], "tags": [], "examples": [{"src": "J’ai fait du tennis.", "tr": "Tôi đã chơi quần vợt."}]}]}, {"pos": "contraction", "pos_vi": "Từ rút gọn", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Của, từ (dạng gộp của de + le).", "sub": [], "tags": [], "examples": [{"src": "Voilà Mike, et il vient du Mississippi.", "tr": "Đây là Mike, Mike đến từ Mississippi."}, {"src": "C'est littéralement la définition du bruit.", "tr": "Đây là định nghĩa của tiếng ồn."}]}]}], "reason": "Le Wiktionnaire vietnamien n'a pas de page pour « du ».", "sources": ["https://fr.wiktionary.org/w/index.php?title=du&oldid=39875873", "https://en.wiktionary.org/w/index.php?title=du&oldid=95842188"]}
{"id": "fr:mais", "by": "claude", "added": "2026-11-27", "add_blocks": [{"pos": "conj", "pos_vi": "Liên từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Nhưng, nhưng mà.", "sub": [], "tags": [], "examples": [{"src": "Mais je lui ai parlé de toute une variété de sujets.", "tr": "Nhưng tôi nói với bà về nhiều vấn đề."}, {"src": "Mais plus important, cela sauve des vies.", "tr": "Nhưng quan trọng hơn, nó cứu mạng sống con người."}]}, {"gloss": "(non seulement… mais) Mà còn.", "sub": [], "tags": [], "examples": [{"src": "Non seulement il est bon, mais encore il est généreux.", "tr": "Anh ấy không chỉ tốt mà còn hào phóng."}]}]}, {"pos": "intj", "pos_vi": "Thán từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Ơ, kìa, thế (tỏ ý ngạc nhiên, không tin hoặc bực bội).", "sub": [], "tags": [], "examples": [{"src": "Mais qu'est-ce que tu fais ?", "tr": "Ơ, cậu đang làm cái gì thế?"}]}]}], "reason": "Le Wiktionnaire vietnamien n'a pas de page pour « mais ».", "sources": ["https://fr.wiktionary.org/w/index.php?title=mais&oldid=39958056", "https://en.wiktionary.org/w/index.php?title=mais&oldid=95717753"]}
{"id": "fr:se", "by": "claude", "added": "2026-11-27", "add_blocks": [{"pos": "pron", "pos_vi": "Đại từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Mình, tự mình (đại từ phản thân ngôi thứ ba; thường không dịch).", "sub": [], "tags": [], "examples": [{"src": "Il se couche tôt.", "tr": "Anh ấy đi ngủ sớm."}]}, {"gloss": "Nhau, lẫn nhau.", "sub": [], "tags": [], "examples": [{"src": "Ils se battent.", "tr": "Họ đánh nhau."}, {"src": "Est-ce qu'elles se parlent ?", "tr": "Chúng trò chuyện với nhau ư?"}]}, {"gloss": "(Nghĩa bị động; không dịch).", "sub": [], "tags": [], "examples": [{"src": "Ce produit se vend bien.", "tr": "Sản phẩm này bán chạy."}]}]}], "reason": "Le Wiktionnaire vietnamien n'a pas de page pour « se ».", "sources": ["https://fr.wiktionary.org/w/index.php?title=se&oldid=39957307", "https://en.wiktionary.org/w/index.php?title=se&oldid=95845684"]}
{"id": "fr:nous", "by": "claude", "added": "2026-11-27", "add_blocks": [{"pos": "pron", "pos_vi": "Đại từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Chúng tôi, chúng ta (ngôi thứ nhất số nhiều, làm chủ ngữ hoặc bổ ngữ).", "sub": [], "tags": [], "examples": [{"src": "Parce que nous n'avons pas dialogué.", "tr": "Bởi vì chúng ta đã không đối thoại."}, {"src": "Et nous en sommes si proches.", "tr": "Và chúng tôi đã đến rất gần."}, {"src": "La Grèce et Rome nous ont apporté la civilisation.", "tr": "Hy Lạp và La Mã đã mang văn minh đến cho chúng ta."}]}]}], "reason": "Le Wiktionnaire vietnamien n'a pas de page pour « nous ».", "sources": ["https://fr.wiktionary.org/w/index.php?title=nous&oldid=40063171", "https://en.wiktionary.org/w/index.php?title=nous&oldid=94533976"]}
{"id": "fr:lui", "by": "claude", "added": "2026-11-27", "add_blocks": [{"pos": "pron", "pos_vi": "Đại từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Cho anh ấy, cho cô ấy, với nó (bổ ngữ gián tiếp, cả giống đực lẫn giống cái).", "sub": [], "tags": [], "examples": [{"src": "Je lui ai donné le livre.", "tr": "Tôi đã đưa quyển sách cho anh ấy."}, {"src": "Je lui ai acheté ça.", "tr": "Mua cho cậu ta cái này."}]}, {"gloss": "Anh ấy, ông ấy, nó (đại từ nhấn mạnh giống đực, sau giới từ hoặc tách khỏi câu).", "sub": [], "tags": [], "examples": [{"src": "J'habitais avec lui.", "tr": "Tôi từng sống với anh ấy."}, {"src": "Il était souvent seul chez lui.", "tr": "Cậu hay phải ở nhà một mình."}]}]}], "reason": "Le Wiktionnaire vietnamien n'a pas de page pour « lui ».", "sources": ["https://fr.wiktionary.org/w/index.php?title=lui&oldid=39770630", "https://en.wiktionary.org/w/index.php?title=lui&oldid=93705797"]}
{"id": "fr:son", "by": "claude", "added": "2026-11-27", "add_blocks": [{"pos": "det", "pos_vi": "Từ hạn định", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Của anh ấy, của cô ấy, của nó, của mình (trước danh từ giống đực số ít hoặc danh từ bắt đầu bằng nguyên âm).", "sub": [], "tags": [], "examples": [{"src": "Elle a perdu son chapeau.", "tr": "Cô ấy làm mất mũ của mình."}, {"src": "Elle ne peut pas lâcher son boulot.", "tr": "Cô cũng không thể bỏ việc."}]}]}, {"pos": "noun", "pos_vi": "Danh từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Âm thanh, tiếng.", "sub": [], "tags": [], "examples": [{"src": "Le son de ce piano est agréable.", "tr": "Tiếng cây đàn piano này nghe hay."}, {"src": "Vous entendriez littéralement le son.", "tr": "Bạn sẽ có thể nghe thấy âm thanh."}]}, {"gloss": "Cám (vỏ hạt lúa mì và ngũ cốc khi xay).", "sub": [], "tags": [], "examples": [{"src": "Ceci est du pain de son.", "tr": "Đây là bánh mì làm bằng cám."}]}]}], "reason": "Le Wiktionnaire vietnamien n'a pas de page pour « son ».", "sources": ["https://fr.wiktionary.org/w/index.php?title=son&oldid=39878143", "https://en.wiktionary.org/w/index.php?title=son&oldid=95859754"]}
{"id": "fr:mon", "by": "claude", "added": "2026-11-27", "add_blocks": [{"pos": "det", "pos_vi": "Từ hạn định", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Của tôi (trước danh từ giống đực số ít hoặc danh từ bắt đầu bằng nguyên âm).", "sub": [], "tags": [], "examples": [{"src": "J'ai perdu mon chapeau.", "tr": "Tôi làm mất mũ của tôi."}, {"src": "C'est mon droit.", "tr": "Đó là quyền của tôi."}]}]}], "reason": "Le Wiktionnaire vietnamien n'a pas de page pour « mon ».", "sources": ["https://fr.wiktionary.org/w/index.php?title=mon&oldid=40043001", "https://en.wiktionary.org/w/index.php?title=mon&oldid=93743539"]}
{"id": "fr:tout", "by": "claude", "added": "2026-11-27", "add_blocks": [{"pos": "det", "pos_vi": "Từ hạn định", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Tất cả, cả, toàn bộ (trước mạo từ, từ chỉ định hoặc từ sở hữu).", "sub": [], "tags": [], "examples": [{"src": "Il a parcouru toute la France.", "tr": "Anh ấy đã đi khắp nước Pháp."}, {"src": "Tous les hommes, tous les animaux, toutes les plantes.", "tr": "Tất cả mọi người, mọi loài vật, mọi cây cỏ."}]}, {"gloss": "Mọi, bất cứ (trước danh từ không có mạo từ).", "sub": [], "tags": [], "examples": [{"src": "Tout bien est désirable.", "tr": "Mọi điều tốt đều đáng mong muốn."}, {"src": "Vous devez combattre tout intrus.", "tr": "Bạn phải đánh lại những kẻ xâm phạm."}]}]}, {"pos": "pron", "pos_vi": "Đại từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Tất cả, mọi thứ.", "sub": [], "tags": [], "examples": [{"src": "C'est tout cela à la fois.", "tr": "Đó là tất cả những thứ đó."}, {"src": "C'est tout pour aujourd'hui.", "tr": "Hôm nay chỉ có vậy thôi."}]}]}, {"pos": "adv", "pos_vi": "Phó từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Rất, hoàn toàn, hẳn.", "sub": [], "tags": [], "examples": [{"src": "Un appartement tout petit.", "tr": "Một căn hộ rất nhỏ."}]}]}, {"pos": "noun", "pos_vi": "Danh từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Toàn bộ, cái tổng thể.", "sub": [], "tags": [], "examples": [{"src": "le tout", "tr": "toàn bộ, tất cả"}]}]}], "reason": "Le Wiktionnaire vietnamien n'a pas de page pour « tout ».", "sources": ["https://fr.wiktionary.org/w/index.php?title=tout&oldid=40057432", "https://en.wiktionary.org/w/index.php?title=tout&oldid=95644194"]}
{"id": "fr:ils", "by": "claude", "added": "2026-11-27", "add_blocks": [{"pos": "pron", "pos_vi": "Đại từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Họ, chúng nó, chúng (ngôi thứ ba số nhiều, làm chủ ngữ; chỉ nhóm giống đực hoặc hỗn hợp).", "sub": [], "tags": [], "examples": [{"src": "Ils peuvent vous voir.", "tr": "Họ có thể nhìn thấy bạn."}, {"src": "Et ils vont fusionner.", "tr": "Và khi đó chúng sẽ nhập vào nhau."}]}]}], "reason": "Le Wiktionnaire vietnamien n'a pas de page pour « ils ».", "sources": ["https://fr.wiktionary.org/w/index.php?title=ils&oldid=40062911", "https://en.wiktionary.org/w/index.php?title=ils&oldid=92646868"]}
{"id": "fr:comme", "by": "claude", "added": "2026-11-27", "add_blocks": [{"pos": "conj", "pos_vi": "Liên từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Như, giống như.", "sub": [], "tags": [], "examples": [{"src": "Tu parles comme un fou.", "tr": "Cậu nói như một kẻ điên."}, {"src": "Des gens comme vous tous ici présents.", "tr": "Những người như tất cả các bạn trong căn phòng này."}]}, {"gloss": "Như là, chẳng hạn như.", "sub": [], "tags": [], "examples": [{"src": "Regardons à un pays comme l'Inde.", "tr": "Hãy xem một đất nước như là Ấn Độ."}]}, {"gloss": "Làm, với tư cách là.", "sub": [], "tags": [], "examples": [{"src": "Je travaille comme artiste.", "tr": "Tôi làm nghệ sĩ."}]}, {"gloss": "Biết bao, sao mà (cảm thán).", "sub": [], "tags": [], "examples": [{"src": "Comme tu es belle ce soir !", "tr": "Tối nay em đẹp biết bao!"}]}, {"gloss": "Vì, bởi vì (thường đứng đầu câu).", "sub": [], "tags": [], "examples": [{"src": "Comme j'étais malade, il est venu me voir.", "tr": "Vì tôi bị ốm nên anh ấy đến thăm tôi."}]}]}], "reason": "Le Wiktionnaire vietnamien n'a pas de page pour « comme ».", "sources": ["https://fr.wiktionary.org/w/index.php?title=comme&oldid=39770570", "https://en.wiktionary.org/w/index.php?title=comme&oldid=93744346"]}
{"id": "fr:moi", "by": "claude", "added": "2026-11-27", "add_blocks": [{"pos": "pron", "pos_vi": "Đại từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Tôi, tớ, mình (đại từ nhấn mạnh ngôi thứ nhất số ít; sau giới từ, sau c’est, sau động từ mệnh lệnh).", "sub": [], "tags": [], "examples": [{"src": "L'État, c'est moi.", "tr": "Nhà nước chính là tôi."}, {"src": "Donne-moi ça !", "tr": "Đưa cái đó cho tôi!"}, {"src": "Pour moi c'est un bonheur profond.", "tr": "Đối với tôi, đó là hạnh phúc sâu thẳm."}]}]}, {"pos": "noun", "pos_vi": "Danh từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Cái tôi, bản ngã.", "sub": [], "tags": [], "examples": [{"src": "Le moi est haïssable.", "tr": "Cái tôi thật đáng ghét."}]}]}], "reason": "Le Wiktionnaire vietnamien n'a pas de page pour « moi ».", "sources": ["https://fr.wiktionary.org/w/index.php?title=moi&oldid=40062318", "https://en.wiktionary.org/w/index.php?title=moi&oldid=94507583"]}
{"id": "fr:te", "by": "claude", "added": "2026-11-27", "add_blocks": [{"pos": "pron", "pos_vi": "Đại từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Bạn, cậu, mày, anh, em (ngôi thứ hai số ít thân mật, làm bổ ngữ trực tiếp hoặc gián tiếp; trước nguyên âm viết t’).", "sub": [], "tags": [], "examples": [{"src": "Il te cite souvent.", "tr": "Anh ấy hay trích lời cậu."}, {"src": "Il te donne le livre.", "tr": "Anh ấy đưa cậu quyển sách."}, {"src": "Je voudrais te prendre dans mes bras.", "tr": "Tôi muốn ôm em."}]}, {"gloss": "Mình, tự mình (đại từ phản thân ngôi thứ hai số ít; thường không dịch).", "sub": [], "tags": [], "examples": [{"src": "Tu te souviens d'elle.", "tr": "Cậu nhớ cô ấy."}, {"src": "Tu te moques de moi ?", "tr": "Con đùa à?"}]}]}], "reason": "Le Wiktionnaire vietnamien n'a pas de page pour « te ».", "sources": ["https://fr.wiktionary.org/w/index.php?title=te&oldid=39941472", "https://en.wiktionary.org/w/index.php?title=te&oldid=95823261"]}
{"id": "fr:où", "by": "claude", "added": "2026-11-27", "add_blocks": [{"pos": "adv", "pos_vi": "Phó từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Đâu, ở đâu, đi đâu (nghi vấn).", "sub": [], "tags": [], "examples": [{"src": "Où est la gare?", "tr": "Nhà ga ở đâu?"}, {"src": "Où es-tu ? Où vas-tu ?", "tr": "Cậu đang ở đâu? Cậu đi đâu?"}]}, {"gloss": "Nơi mà, chỗ mà (quan hệ, chỉ nơi chốn).", "sub": [], "tags": [], "examples": [{"src": "Voilà où Health Leads commence.", "tr": "Đó là nơi Health Leads đã bắt đầu."}, {"src": "la terre où on la sème", "tr": "mảnh đất nơi người ta gieo nó"}]}, {"gloss": "Khi mà, lúc mà (quan hệ, chỉ thời gian).", "sub": [], "tags": [], "examples": [{"src": "Il s’est réveillé au moment où l’accident a eu lieu.", "tr": "Anh ấy tỉnh dậy đúng lúc tai nạn xảy ra."}]}]}], "reason": "Le Wiktionnaire vietnamien n'a pas de page pour « où ».", "sources": ["https://fr.wiktionary.org/w/index.php?title=o%C3%B9&oldid=39941390", "https://en.wiktionary.org/w/index.php?title=o%C3%B9&oldid=92546579"]}
{"id": "fr:ou", "by": "claude", "added": "2026-11-27", "add_blocks": [{"pos": "conj", "pos_vi": "Liên từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Hoặc, hay, hay là.", "sub": [], "tags": [], "examples": [{"src": "Son beau-frère ou le mari de sa sœur.", "tr": "Anh rể của cô ấy, hay là chồng của chị cô ấy."}, {"src": "Ou devrais-je dire plus précisément, Senor Pringle.", "tr": "Hay có lẽ chính xác hơn, ngài Pringle."}]}, {"gloss": "(ou… ou…) Hoặc… hoặc…, hoặc là… hoặc là….", "sub": [], "tags": [], "examples": [{"src": "Ou il est fou ou il est bête.", "tr": "Hoặc là anh ta điên, hoặc là anh ta ngốc."}]}]}], "reason": "Le Wiktionnaire vietnamien n'a pas de page pour « ou ».", "sources": ["https://fr.wiktionary.org/w/index.php?title=ou&oldid=39955648", "https://en.wiktionary.org/w/index.php?title=ou&oldid=93712093"]}
{"id": "fr:quand", "by": "claude", "added": "2026-11-27", "add_blocks": [{"pos": "conj", "pos_vi": "Liên từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Khi, lúc, khi mà.", "sub": [], "tags": [], "examples": [{"src": "Appelez-moi quand vous arriverez chez vous.", "tr": "Hãy gọi cho tôi khi anh về đến nhà."}, {"src": "Quand je regarde cette photo,", "tr": "Khi nhìn lại bức ảnh này,"}]}, {"gloss": "Dù, cho dù (với thức điều kiện).", "sub": [], "tags": [], "examples": [{"src": "Quand je le voudrais, je ne le pourrais pas.", "tr": "Cho dù tôi có muốn, tôi cũng không làm được."}]}]}, {"pos": "adv", "pos_vi": "Phó từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Khi nào, bao giờ, lúc nào (nghi vấn).", "sub": [], "tags": [], "examples": [{"src": "Quand est-il mort ?", "tr": "Ông ấy mất khi nào?"}, {"src": "Dis, quand reviendras-tu ?", "tr": "Này, bao giờ anh trở lại?"}, {"src": "Quand est-ce que je cède ?", "tr": "Khi nào mình đầu hàng?"}]}]}], "reason": "Le Wiktionnaire vietnamien n'a pas de page pour « quand ».", "sources": ["https://fr.wiktionary.org/w/index.php?title=quand&oldid=40004559", "https://en.wiktionary.org/w/index.php?title=quand&oldid=93539008"]}
{"id": "fr:si", "by": "claude", "added": "2026-11-27", "add_blocks": [{"pos": "conj", "pos_vi": "Liên từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Nếu, giả sử.", "sub": [], "tags": [], "examples": [{"src": "Si j’étais riche, je m’achèterais une maison.", "tr": "Nếu tôi giàu, tôi sẽ mua một ngôi nhà."}, {"src": "Et si j'augmente le zoom vers là, vous la voyez.", "tr": "Và nếu tôi phóng to nó lên, bạn nhìn thấy nó."}]}, {"gloss": "Có… không, liệu (câu hỏi gián tiếp).", "sub": [], "tags": [], "examples": [{"src": "Je ne sais pas si je viendrai.", "tr": "Tôi không biết tôi có đến không."}, {"src": "Je me demande si elle sera seule.", "tr": "Tôi tự hỏi liệu cô ấy có ở một mình không."}]}, {"gloss": "(si seulement) Giá mà, phải chi (chỉ mong ước, tiếc nuối).", "sub": [], "tags": [], "examples": [{"src": "Si seulement il était venu !", "tr": "Giá mà anh ấy đã đến!"}]}]}, {"pos": "adv", "pos_vi": "Phó từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Rất, quá, đến thế.", "sub": [], "tags": [], "examples": [{"src": "J’étais si fatigué ces jours-ci que je n’avais pas le courage de vous écrire.", "tr": "Mấy hôm nay tôi mệt đến mức không còn sức viết thư cho anh."}, {"src": "Et nous en sommes si proches.", "tr": "Và chúng tôi đã đến rất gần."}]}, {"gloss": "Bằng (trong so sánh phủ định).", "sub": [], "tags": [], "examples": [{"src": "Je ne suis pas si grand que lui.", "tr": "Tôi không cao bằng anh ấy."}]}]}, {"pos": "intj", "pos_vi": "Thán từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Có chứ, có mà (đáp lại câu hỏi hay câu nói phủ định).", "sub": [], "tags": [], "examples": [{"src": "Tu ne m’aimes pas, n’est-ce pas ? — Si !", "tr": "Anh không yêu em, phải không? — Có chứ!"}]}]}, {"pos": "noun", "pos_vi": "Danh từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Nốt si (nốt thứ bảy của gam đô).", "sub": [], "tags": [], "examples": [{"src": "La Messe en si mineur de Jean-Sébastien Bach.", "tr": "Bản Thánh lễ cung si thứ của Johann Sebastian Bach."}]}]}], "reason": "Le Wiktionnaire vietnamien n'a pas de page pour « si ».", "sources": ["https://fr.wiktionary.org/w/index.php?title=si&oldid=39935087", "https://en.wiktionary.org/w/index.php?title=si&oldid=95788094"]}
{"id": "fr:toi", "by": "claude", "added": "2026-11-27", "add_blocks": [{"pos": "pron", "pos_vi": "Đại từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Bạn, cậu, mày, anh, em (đại từ nhấn mạnh ngôi thứ hai số ít thân mật; sau giới từ, sau c’est).", "sub": [], "tags": [], "examples": [{"src": "J'ai besoin de toi.", "tr": "Tôi cần cậu."}, {"src": "Je crois en toi.", "tr": "Tôi tin cậu."}, {"src": "Je veux venir avec toi.", "tr": "Cháu muốn đi với cô."}]}, {"gloss": "Mình (đại từ phản thân sau động từ mệnh lệnh; thường không dịch).", "sub": [], "tags": [], "examples": [{"src": "Souviens-toi de ce qui est vraiment important.", "tr": "Hãy nhớ điều thật sự quan trọng."}]}]}], "reason": "Le Wiktionnaire vietnamien n'a pas de page pour « toi ».", "sources": ["https://fr.wiktionary.org/w/index.php?title=toi&oldid=40062373", "https://en.wiktionary.org/w/index.php?title=toi&oldid=95670243"]}
{"id": "fr:falloir", "by": "claude", "added": "2026-11-27", "add_blocks": [{"pos": "verb", "pos_vi": "Động từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Phải, cần phải (động từ không ngôi, dùng với il: il faut).", "sub": [], "tags": [], "examples": [{"src": "Il faut que j'y aille.", "tr": "Tôi phải đi đây."}, {"src": "(Rires) Oui, il va falloir travailler là-dessus.", "tr": "(Cười) Vâng, chúng tôi sẽ phải làm gì đó."}]}, {"gloss": "Cần, cần có.", "sub": [], "tags": [], "examples": [{"src": "Combien vous faut-il pour votre voyage ?", "tr": "Anh cần bao nhiêu tiền cho chuyến đi?"}, {"src": "Et il va nous falloir beaucoup de travail pour changer ça.", "tr": "Và sẽ cần hành động thực tiễn để thay đổi."}]}, {"gloss": "Mất (bao nhiêu thời gian).", "sub": [], "tags": [], "examples": [{"src": "Il me fallut longtemps pour comprendre d'où il venait.", "tr": "Tôi mất nhiều thời gian mới hiểu anh ta từ đâu đến."}]}]}], "reason": "Le Wiktionnaire vietnamien n'a pas de page pour « falloir ».", "sources": ["https://fr.wiktionary.org/w/index.php?title=falloir&oldid=39842917", "https://en.wiktionary.org/w/index.php?title=falloir&oldid=93693485"]}
{"id": "fr:votre", "by": "claude", "added": "2026-11-27", "add_blocks": [{"pos": "det", "pos_vi": "Từ hạn định", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Của các bạn, của anh, của chị, của ông, của bà (ngôi thứ hai số nhiều hoặc lịch sự; trước danh từ số ít).", "sub": [], "tags": [], "examples": [{"src": "Monsieur, c'est votre portefeuille ?", "tr": "Thưa ông, đây có phải ví của ông không?"}, {"src": "Je vous remercie de votre attention.", "tr": "Cảm ơn sự lắng nghe của các bạn."}]}, {"gloss": "(Trước tước hiệu, để tỏ lòng kính trọng) Thưa, kính thưa.", "sub": [], "tags": [], "examples": [{"src": "Votre Altesse, Votre Majesté.", "tr": "Thưa Điện hạ, thưa Bệ hạ."}]}]}], "reason": "Le Wiktionnaire vietnamien n'a pas de page pour « votre ».", "sources": ["https://fr.wiktionary.org/w/index.php?title=votre&oldid=39844733", "https://en.wiktionary.org/w/index.php?title=votre&oldid=95373271"]}
{"id": "fr:même", "by": "claude", "added": "2026-11-27", "add_blocks": [{"pos": "adj", "pos_vi": "Tính từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Cùng, giống nhau, như nhau (đứng trước danh từ).", "sub": [], "tags": [], "examples": [{"src": "Je l'ai acheté le même jour.", "tr": "Tôi mua nó cùng ngày."}, {"src": "Ce garçon porte la même veste que son frère.", "tr": "Cậu bé này mặc chiếc áo khoác giống hệt anh mình."}]}, {"gloss": "Chính, đích thị (đứng sau danh từ hoặc đại từ, để nhấn mạnh).", "sub": [], "tags": [], "examples": [{"src": "Ah, la personne même que je voulais voir!", "tr": "À, chính người tôi muốn gặp đây rồi!"}]}]}, {"pos": "adv", "pos_vi": "Phó từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Ngay cả, thậm chí, cả.", "sub": [], "tags": [], "examples": [{"src": "Même les rois doivent mourir.", "tr": "Ngay cả vua chúa cũng phải chết."}, {"src": "Nous les guérissons même.", "tr": "Chúng ta thậm chí chữa lành cho họ."}, {"src": "Et on y trouve même une église.", "tr": "Thậm chí bạn còn tìm thấy một nhà thờ."}]}]}, {"pos": "pron", "pos_vi": "Đại từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "(le même, la même) Người ấy, cái ấy, như cũ; (les mêmes) cũng những người ấy.", "sub": [], "tags": [], "examples": [{"src": "Il est toujours le même, toujours aussi gentil.", "tr": "Anh ấy vẫn như xưa, vẫn tử tế như thế."}, {"src": "Ce sont toujours les mêmes qui font le travail !", "tr": "Lúc nào cũng chỉ những người ấy làm việc!"}]}]}], "reason": "Le Wiktionnaire vietnamien n'a pas de page pour « même ».", "sources": ["https://fr.wiktionary.org/w/index.php?title=m%C3%AAme&oldid=39991560", "https://en.wiktionary.org/w/index.php?title=m%C3%AAme&oldid=91996657"]}
{"id": "fr:toujours", "by": "claude", "added": "2026-11-27", "add_blocks": [{"pos": "adv", "pos_vi": "Phó từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Luôn, luôn luôn, lúc nào cũng.", "sub": [], "tags": [], "examples": [{"src": "Il est toujours en retard.", "tr": "Anh ấy lúc nào cũng đến muộn."}, {"src": "Et vous pouvez toujours vous en aller.", "tr": "Bạn luôn có thể đứng dậy bỏ đi."}]}, {"gloss": "Vẫn, vẫn còn.", "sub": [], "tags": [], "examples": [{"src": "Il l’aime toujours.", "tr": "Anh ấy vẫn yêu cô ấy."}, {"src": "Je trouve toujours ça très romantique.", "tr": "Tôi vẫn thấy điều đó thật lãng mạn."}]}, {"gloss": "(pour toujours) Mãi mãi, vĩnh viễn.", "sub": [], "tags": [], "examples": [{"src": "Je suis devenue accro pour toujours.", "tr": "Và tôi vĩnh viễn gắn liền với chúng."}]}, {"gloss": "Dù sao, đằng nào cũng.", "sub": [], "tags": [], "examples": [{"src": "Ça peut toujours servir.", "tr": "Dù sao thì nó cũng có thể có ích."}]}]}], "reason": "Le Wiktionnaire vietnamien n'a pas de page pour « toujours ».", "sources": ["https://fr.wiktionary.org/w/index.php?title=toujours&oldid=39879817", "https://en.wiktionary.org/w/index.php?title=toujours&oldid=90318602"]}
{"id": "fr:ton", "by": "claude", "added": "2026-11-27", "add_blocks": [{"pos": "det", "pos_vi": "Từ hạn định", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Của bạn, của cậu, của mày, của anh, của em (ngôi thứ hai số ít thân mật; trước danh từ giống đực số ít hoặc danh từ bắt đầu bằng nguyên âm).", "sub": [], "tags": [], "examples": [{"src": "Tu as pensé à prendre ton livre ?", "tr": "Cậu có nhớ mang sách của cậu không?"}, {"src": "Oh, ton nom c'est pas BERT.", "tr": "Ồ, tên của anh không phải là BERT à."}]}]}, {"pos": "noun", "pos_vi": "Danh từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Giọng, giọng điệu (cách nói).", "sub": [], "tags": [], "examples": [{"src": "Je n'aime pas le ton sur lequel tu me parles!", "tr": "Tôi không thích cái giọng cậu nói với tôi!"}]}, {"gloss": "Cung, giọng (âm nhạc); một cung (khoảng cách hai nửa cung).", "sub": [], "tags": [], "examples": [{"src": "Il y a un ton entre do et ré.", "tr": "Giữa đô và rê cách nhau một cung."}]}, {"gloss": "Sắc, tông (màu).", "sub": [], "tags": [], "examples": [{"src": "Différents tons de rouge.", "tr": "Nhiều sắc đỏ khác nhau."}]}]}], "reason": "Le Wiktionnaire vietnamien n'a pas de page pour « ton ».", "sources": ["https://fr.wiktionary.org/w/index.php?title=ton&oldid=39773107", "https://en.wiktionary.org/w/index.php?title=ton&oldid=95709123"]}
{"id": "fr:arriver", "by": "claude", "added": "2026-11-27", "add_blocks": [{"pos": "verb", "pos_vi": "Động từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Đến, tới (nơi nào).", "sub": [], "tags": [], "examples": [{"src": "On est arrivés à Paris vers 9 heures.", "tr": "Chúng tôi đến Paris vào khoảng 9 giờ."}, {"src": "Mais les Mongols arriver les premiers.", "tr": "Nhưng quân Mông Cổ đến trước."}]}, {"gloss": "Xảy ra, xảy đến.", "sub": [], "tags": [], "examples": [{"src": "Ça ne m'arrive jamais.", "tr": "Chuyện đó chẳng bao giờ xảy ra với tôi."}, {"src": "Et je pense que c'est ce qui va arriver.", "tr": "Và tôi nghĩ đó là điều sẽ xảy ra."}]}, {"gloss": "(arriver à + động từ nguyên mẫu) Làm được, xoay xở được.", "sub": [], "tags": [], "examples": [{"src": "Je suis finalement arrivé à réparer cette porte.", "tr": "Cuối cùng tôi cũng sửa được cái cửa đó."}]}, {"gloss": "Sắp đến, tới (thời gian, sự việc).", "sub": [], "tags": [], "examples": [{"src": "La nuit arrive.", "tr": "Màn đêm buông xuống."}]}]}], "reason": "Le Wiktionnaire vietnamien n'a pas de page pour « arriver ».", "sources": ["https://fr.wiktionary.org/w/index.php?title=arriver&oldid=40004141", "https://en.wiktionary.org/w/index.php?title=arriver&oldid=94546613"]}
{"id": "fr:quoi", "by": "claude", "added": "2026-11-27", "add_blocks": [{"pos": "pron", "pos_vi": "Đại từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Gì, cái gì (nghi vấn; sau giới từ hoặc cuối câu).", "sub": [], "tags": [], "examples": [{"src": "De quoi parle-t-il ?", "tr": "Anh ấy đang nói về cái gì?"}, {"src": "C'est quoi ?", "tr": "Cái gì thế?"}, {"src": "A quoi servaient ces objets ?", "tr": "Những đồ cổ này dùng để làm gì?"}]}, {"gloss": "Điều mà, cái mà (sau giới từ hoặc trước động từ nguyên mẫu).", "sub": [], "tags": [], "examples": [{"src": "Je sais quoi faire.", "tr": "Tôi biết phải làm gì."}, {"src": "Voilà à quoi ça ressemble.", "tr": "Nó trông như thế này."}]}, {"gloss": "(de quoi) Đủ để, cái để.", "sub": [], "tags": [], "examples": [{"src": "Il y avait de quoi remplir trois boîtes.", "tr": "Có đủ để đầy ba hộp."}]}, {"gloss": "(quoi que) Dù gì đi nữa, bất kể điều gì.", "sub": [], "tags": [], "examples": [{"src": "Quoi qu'il arrive, je serai là.", "tr": "Dù có chuyện gì xảy ra, tôi vẫn sẽ ở đây."}]}]}, {"pos": "intj", "pos_vi": "Thán từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Gì cơ, sao (tỏ ý ngạc nhiên, không nghe rõ hoặc phẫn nộ).", "sub": [], "tags": [], "examples": [{"src": "Quoi ! Vous avez fait cette imprudence !", "tr": "Sao! Anh đã làm điều liều lĩnh ấy à!"}]}, {"gloss": "Đấy, mà (cuối câu, để tìm sự đồng tình; thân mật).", "sub": [], "tags": ["familier"], "examples": [{"src": "Arsène Lupin, quoi !", "tr": "Arsène Lupin đấy!"}]}]}], "reason": "Le Wiktionnaire vietnamien n'a pas de page pour « quoi ».", "sources": ["https://fr.wiktionary.org/w/index.php?title=quoi&oldid=39930235", "https://en.wiktionary.org/w/index.php?title=quoi&oldid=88849369"]}
{"id": "fr:main", "by": "claude", "added": "2026-11-27", "add_blocks": [{"pos": "noun", "pos_vi": "Danh từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Tay, bàn tay.", "sub": [], "tags": [], "examples": [{"src": "Levez la main svp.", "tr": "Làm ơn hãy giơ tay lên ạ."}, {"src": "Je tiens le couteau dans ma main.", "tr": "Tôi nắm con dao trong tay."}]}, {"gloss": "Tay nghề, sự khéo tay.", "sub": [], "tags": [], "examples": [{"src": "On sent encore la main de leur inventeur.", "tr": "Người ta vẫn cảm nhận được bàn tay của người sáng chế ra chúng."}]}, {"gloss": "Lỗi chơi bóng bằng tay (bóng đá).", "sub": [], "tags": [], "examples": [{"src": "une main de Van de Korput", "tr": "một lỗi chơi bóng bằng tay của Van de Korput"}]}, {"gloss": "Nhân công, người làm.", "sub": [], "tags": [], "examples": [{"src": "Quelques mains en plus ne feront pas de mal.", "tr": "Thêm vài người làm cũng chẳng hại gì."}]}]}], "reason": "Le Wiktionnaire vietnamien n'a pas de page pour « main ».", "sources": ["https://fr.wiktionary.org/w/index.php?title=main&oldid=40047726", "https://en.wiktionary.org/w/index.php?title=main&oldid=95806489"]}
{"id": "fr:notre", "by": "claude", "added": "2026-11-27", "add_blocks": [{"pos": "det", "pos_vi": "Từ hạn định", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Của chúng tôi, của chúng ta (trước danh từ số ít).", "sub": [], "tags": [], "examples": [{"src": "C'est notre maison.", "tr": "Đây là nhà của chúng tôi."}, {"src": "Alors, ça ne ressemble pas à notre planète.", "tr": "Nó không giống hành tinh của chúng ta."}]}]}], "reason": "Le Wiktionnaire vietnamien n'a pas de page pour « notre ».", "sources": ["https://fr.wiktionary.org/w/index.php?title=notre&oldid=39770637", "https://en.wiktionary.org/w/index.php?title=notre&oldid=93743585"]}
{"id": "fr:pourquoi", "by": "claude", "added": "2026-11-27", "add_blocks": [{"pos": "adv", "pos_vi": "Phó từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Tại sao, vì sao, sao.", "sub": [], "tags": [], "examples": [{"src": "Pourquoi as-tu fait cela ?", "tr": "Tại sao cậu làm thế?"}, {"src": "Pourquoi cela ?", "tr": "Tại sao lại thế?"}, {"src": "Il faut qu’il vienne, ou qu’il dise pourquoi.", "tr": "Anh ta phải đến, hoặc phải nói vì sao."}]}]}, {"pos": "noun", "pos_vi": "Danh từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Lý do, nguyên nhân; câu hỏi tại sao.", "sub": [], "tags": [], "examples": [{"src": "Se pose maintenant la question du pourquoi.", "tr": "Giờ đặt ra câu hỏi về lý do."}]}]}], "reason": "Le Wiktionnaire vietnamien n'a pas de page pour « pourquoi ».", "sources": ["https://fr.wiktionary.org/w/index.php?title=pourquoi&oldid=40012920", "https://en.wiktionary.org/w/index.php?title=pourquoi&oldid=92727232"]}
{"id": "fr:est-ce que", "by": "claude", "added": "2026-11-27", "add_blocks": [{"pos": "particle", "pos_vi": "Tiểu từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Có… không (đứng đầu câu để hỏi; thường không dịch).", "sub": [], "tags": [], "examples": [{"src": "Est-ce que tu veux une chambre ?", "tr": "Cậu có muốn một phòng ngủ không?"}, {"src": "Est-ce que ça arrivera à nouveau ?", "tr": "Nó sẽ xảy ra nữa không?"}]}, {"gloss": "(Sau từ để hỏi, giữ trật tự chủ ngữ – động từ; không dịch).", "sub": [], "tags": [], "examples": [{"src": "Quand est-ce que les élèves retournent à l’école ?", "tr": "Khi nào học sinh đi học lại?"}, {"src": "Comment est-ce que c'est arrivé ?", "tr": "Điều đó xảy ra như thế nào?"}]}]}], "reason": "Le Wiktionnaire vietnamien n'a pas de page pour « est-ce que ».", "sources": ["https://fr.wiktionary.org/w/index.php?title=est-ce%20que&oldid=39281202", "https://en.wiktionary.org/w/index.php?title=est-ce%20que&oldid=95732954"]}
{"id": "fr:coup", "by": "claude", "added": "2026-11-27", "add_blocks": [{"pos": "noun", "pos_vi": "Danh từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Cú, cú đánh, đòn.", "sub": [], "tags": [], "examples": [{"src": "marqué de coups", "tr": "đầy vết đòn"}]}, {"gloss": "(coup de…) Cái, cú, lần (hành động nhanh, chốc lát).", "sub": [], "tags": [], "examples": [{"src": "Alors, jetez un coup d'oeil.", "tr": "Nào, hãy cùng xem."}, {"src": "coup de tonnerre", "tr": "tiếng sấm"}, {"src": "Ce fut mon premier coup de soleil.", "tr": "Đây là vết rám nắng đầu tiên của tôi."}]}, {"gloss": "Phát (súng).", "sub": [], "tags": [], "examples": [{"src": "pistolet à six coups", "tr": "súng lục sáu phát"}]}, {"gloss": "Cú sốc, đòn giáng (việc gây đau buồn bất ngờ).", "sub": [], "tags": [], "examples": [{"src": "Ça m’a donné un coup.", "tr": "Việc đó làm tôi choáng váng."}]}, {"gloss": "Nước đi, đòn (trong trò chơi); vố, mưu.", "sub": [], "tags": [], "examples": [{"src": "Il a fait un beau coup.", "tr": "Anh ta đã đi một nước hay."}, {"src": "préparer son coup", "tr": "chuẩn bị mưu tính"}]}, {"gloss": "Lần.", "sub": [], "tags": [], "examples": [{"src": "Encore un coup, ce n'est là qu'une présomption.", "tr": "Một lần nữa, đó chỉ là một giả định."}]}]}], "reason": "Le Wiktionnaire vietnamien n'a pas de page pour « coup ».", "sources": ["https://fr.wiktionary.org/w/index.php?title=coup&oldid=40004772", "https://en.wiktionary.org/w/index.php?title=coup&oldid=95409937"]}
{"id": "fr:dont", "by": "claude", "added": "2026-11-27", "add_blocks": [{"pos": "pron", "pos_vi": "Đại từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Mà, về… mà, của… mà (đại từ quan hệ thay cho de + danh từ).", "sub": [], "tags": [], "examples": [{"src": "Vous rappelez-vous ce dont je vous ai parlé ?", "tr": "Anh có nhớ điều mà tôi đã nói với anh không?"}, {"src": "Ce sont tous des outils dont nous avons besoin.", "tr": "Đó là tất cả các công cụ chúng ta cần."}]}, {"gloss": "Trong đó, trong số đó (chỉ một phần của tập hợp).", "sub": [], "tags": [], "examples": [{"src": "Il a eu dix enfants, dont neuf filles.", "tr": "Ông ấy có mười người con, trong đó chín con gái."}]}]}], "reason": "Le Wiktionnaire vietnamien n'a pas de page pour « dont ».", "sources": ["https://fr.wiktionary.org/w/index.php?title=dont&oldid=40060775", "https://en.wiktionary.org/w/index.php?title=dont&oldid=95813938"]}
{"id": "fr:air", "by": "claude", "added": "2026-11-27", "add_blocks": [{"pos": "noun", "pos_vi": "Danh từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Không khí.", "sub": [], "tags": [], "examples": [{"src": "Donc, un air agréable s'engoufre.", "tr": "Không khí trong lành ùa vào trong."}, {"src": "trou d'air", "tr": "lỗ hổng không khí"}]}, {"gloss": "Bầu trời, không trung.", "sub": [], "tags": [], "examples": [{"src": "La conquête de l’air.", "tr": "Cuộc chinh phục bầu trời."}]}, {"gloss": "Gió.", "sub": [], "tags": [], "examples": [{"src": "Il n’y a pas un brin d’air.", "tr": "Không có lấy một chút gió."}]}, {"gloss": "Vẻ, dáng vẻ, vẻ mặt; (avoir l’air) có vẻ, trông như.", "sub": [], "tags": [], "examples": [{"src": "Les enfants regardèrent d'un air abasourdi.", "tr": "Đám trẻ nhìn với vẻ sửng sốt."}]}, {"gloss": "(prendre des airs) Làm bộ, làm ra vẻ.", "sub": [], "tags": [], "examples": [{"src": "prendre des airs", "tr": "làm bộ làm tịch"}]}, {"gloss": "Điệu nhạc, giai điệu, khúc hát.", "sub": [], "tags": [], "examples": [{"src": "Allons-nous jouer un air ?", "tr": "Giờ mình chơi một giai điệu gì đó nha?"}]}]}], "reason": "Le Wiktionnaire vietnamien n'a pas de page pour « air ».", "sources": ["https://fr.wiktionary.org/w/index.php?title=air&oldid=39913490", "https://en.wiktionary.org/w/index.php?title=air&oldid=95733032"]}
{"id": "fr:oh", "by": "claude", "added": "2026-11-27", "add_blocks": [{"pos": "intj", "pos_vi": "Thán từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Ô, ồ, ôi (tỏ ý ngạc nhiên, thất vọng, thán phục hoặc biết ơn).", "sub": [], "tags": [], "examples": [{"src": "Oh ! Mon équipe favorite a perdu.", "tr": "Ôi! Đội tôi thích đã thua rồi."}, {"src": "Oh ! Qu’il est beau.", "tr": "Ồ! Đẹp quá."}, {"src": "Oh, c'est fantastique !", "tr": "Ồ, nó thật khó tin!"}]}]}], "reason": "Le Wiktionnaire vietnamien n'a pas de page pour « oh ».", "sources": ["https://fr.wiktionary.org/w/index.php?title=oh&oldid=39764266", "https://en.wiktionary.org/w/index.php?title=oh&oldid=93740167"]}
{"id": "fr:monsieur", "by": "claude", "added": "2026-11-27", "add_blocks": [{"pos": "noun", "pos_vi": "Danh từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Ông, ngài, thưa ông (cách gọi lịch sự với đàn ông, có hoặc không kèm tên).", "sub": [], "tags": [], "examples": [{"src": "Bonjour, monsieur !", "tr": "Xin chào ông!"}, {"src": "Oh, bonjour Monsieur.", "tr": "Ồ, chào ngài."}]}, {"gloss": "Quý ông, người đàn ông (lịch sự).", "sub": [], "tags": [], "examples": [{"src": "Il y a un monsieur pour vous voir.", "tr": "Có một ông đến gặp anh."}, {"src": "Vous connaissez ce monsieur, non ?", "tr": "Bạn biết quý ông này phải không?"}]}]}], "reason": "Le Wiktionnaire vietnamien n'a pas de page pour « monsieur ».", "sources": ["https://fr.wiktionary.org/w/index.php?title=monsieur&oldid=39870815", "https://en.wiktionary.org/w/index.php?title=monsieur&oldid=93316819"]}
{"id": "fr:donc", "by": "claude", "added": "2026-11-27", "add_blocks": [{"pos": "adv", "pos_vi": "Phó từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Vậy, vậy thì, cho nên, do đó.", "sub": [], "tags": [], "examples": [{"src": "Je pense, donc je suis.", "tr": "Tôi tư duy, vậy tôi tồn tại."}, {"src": "Ainsi donc vous refusez.", "tr": "Vậy là anh từ chối."}]}, {"gloss": "Thế, đi, nào (nhấn mạnh lời yêu cầu, sự ngạc nhiên; thường không dịch).", "sub": [], "tags": [], "examples": [{"src": "Dites-nous donc comment la chose s’est passée.", "tr": "Kể cho chúng tôi nghe đi, chuyện đã xảy ra thế nào."}]}, {"gloss": "(Trở lại điều đang nói) Vậy, như tôi đã nói.", "sub": [], "tags": [], "examples": [{"src": "Je disais donc que…", "tr": "Vậy, tôi đang nói là…"}]}]}], "reason": "Le Wiktionnaire vietnamien n'a pas de page pour « donc ».", "sources": ["https://fr.wiktionary.org/w/index.php?title=donc&oldid=39773921", "https://en.wiktionary.org/w/index.php?title=donc&oldid=95814786"]}
{"id": "fr:ni", "by": "claude", "added": "2026-11-27", "add_blocks": [{"pos": "conj", "pos_vi": "Liên từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Cũng không, mà cũng không; (ni… ni…) không… cũng không… (đi với ne).", "sub": [], "tags": [], "examples": [{"src": "La terre n'est ni plate ni ronde.", "tr": "Trái Đất không phẳng cũng không tròn."}, {"src": "Il n'a répondu ni oui ni non.", "tr": "Anh ấy không trả lời có cũng không trả lời không."}, {"src": "Il n'est pas aussi précis, ni aussi rapide.", "tr": "Nó không chính xác bằng, cũng không nhanh bằng."}]}]}], "reason": "Le Wiktionnaire vietnamien n'a pas de page pour « ni ».", "sources": ["https://fr.wiktionary.org/w/index.php?title=ni&oldid=39878037", "https://en.wiktionary.org/w/index.php?title=ni&oldid=95841600"]}
{"id": "fr:elles", "by": "claude", "added": "2026-11-27", "add_blocks": [{"pos": "pron", "pos_vi": "Đại từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Họ, các cô ấy, các bà ấy, chúng (ngôi thứ ba số nhiều giống cái, làm chủ ngữ).", "sub": [], "tags": [], "examples": [{"src": "Elles vous huent.", "tr": "Chúng chế nhạo bạn."}, {"src": "Et elles cherchaient la réponse.", "tr": "Và họ tìm kiếm câu trả lời."}]}, {"gloss": "Họ, các cô ấy, chúng (đại từ nhấn mạnh giống cái số nhiều, sau giới từ hoặc tách khỏi câu).", "sub": [], "tags": [], "examples": [{"src": "Elles, elles n’ont rien fait !", "tr": "Các cô ấy thì chẳng làm gì cả!"}, {"src": "Vous interagissez avec elles.", "tr": "Bạn giao tiếp với chúng."}]}]}], "reason": "Le Wiktionnaire vietnamien n'a pas de page pour « elles ».", "sources": ["https://fr.wiktionary.org/w/index.php?title=elles&oldid=39720213", "https://en.wiktionary.org/w/index.php?title=elles&oldid=95739444"]}
{"id": "fr:gens", "by": "claude", "added": "2026-11-27", "add_blocks": [{"pos": "noun", "pos_vi": "Danh từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Người, người ta, mọi người (số nhiều).", "sub": [], "tags": [], "examples": [{"src": "Ça fait réagir les gens.", "tr": "Điều đó khiến người ta phản ứng."}, {"src": "Ces gens-là ont toujours été sympas avec moi.", "tr": "Những người đó lúc nào cũng tử tế với tôi."}, {"src": "Alors, qu'arrive-t-il à ces gens ?", "tr": "Vậy thì chuyện gì đang xảy ra với những người này?"}]}, {"gloss": "(gens de…) Giới, những người làm (một nghề).", "sub": [], "tags": [], "examples": [{"src": "les gens d’Église", "tr": "giới tu sĩ"}]}]}], "reason": "Le Wiktionnaire vietnamien n'a pas de page pour « gens ».", "sources": ["https://fr.wiktionary.org/w/index.php?title=gens&oldid=39969490", "https://en.wiktionary.org/w/index.php?title=gens&oldid=93744922"]}
