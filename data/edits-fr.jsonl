{"id": "fr:certain", "by": "claude", "added": "2026-11-27", "add_blocks": [{"pos": "adj", "pos_vi": "Tính từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Chắc chắn, đích xác (không thể nghi ngờ).", "sub": [], "tags": [], "examples": [{"src": "Ce ne sera pas facile. C'est certain.", "tr": "Sẽ không dễ dàng. Chắc chắn là như vậy."}]}, {"gloss": "Chắc, tin chắc (người nói tin chắc điều gì).", "sub": [], "tags": [], "examples": [{"src": "Je n'en suis pas certain.", "tr": "Tôi không chắc về điều đó."}]}, {"gloss": "Nào đó, một số, nhất định (đặt trước danh từ).", "sub": [], "tags": [], "examples": [{"src": "Il y a un certain nombre d'erreurs.", "tr": "Có một số lỗi."}, {"src": "Cet homme jouit d'une certaine réputation.", "tr": "Người này có một danh tiếng nhất định."}]}, {"gloss": "Một (người tên là)… nào đó (trước tên riêng, chỉ người ít ai biết).", "sub": [], "tags": [], "examples": [{"src": "Un certain Kevin a demandé à te voir.", "tr": "Một anh Kevin nào đó đã hỏi gặp cậu."}]}]}, {"pos": "pron", "pos_vi": "Đại từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Một số người, có người (thường ở số nhiều: certains).", "sub": [], "tags": [], "examples": [{"src": "Certains repartent dans leur pays.", "tr": "Một số người trở về nước."}]}]}], "reason": "Le Wiktionnaire vietnamien n'a pas de page pour « certain ».", "sources": ["https://fr.wiktionary.org/w/index.php?title=certain&oldid=39848777", "https://en.wiktionary.org/w/index.php?title=certain&oldid=95670073"]}
