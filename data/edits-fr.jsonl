{"id": "fr:lequel", "by": "claude", "added": "2026-11-27", "add_blocks": [{"pos": "pron", "pos_vi": "Đại từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Mà, cái mà, người mà (đại từ quan hệ, thường đứng sau giới từ).", "sub": [], "tags": [], "examples": [{"src": "Le camion avec lequel ils partent en tournée.", "tr": "Chiếc xe mà họ dùng để đi lưu diễn."}, {"src": "Elle préfère l'homme avec lequel tu sortais.", "tr": "Cô ấy thích người đàn ông mà cậu từng hẹn hò hơn."}]}, {"gloss": "Cái nào, người nào (nghi vấn, chọn trong một nhóm).", "sub": [], "tags": [], "examples": [{"src": "Vous avez trouvé lequel est sec ?", "tr": "Bạn đoán ra chiếc nào khô rồi chứ?"}, {"src": "Passe-moi le ballon. ― Lequel ? Il y en a trois.", "tr": "Đưa tớ quả bóng. ― Quả nào? Có những ba quả."}]}]}], "reason": "Le Wiktionnaire vietnamien n'a pas de page pour « lequel ».", "sources": ["https://fr.wiktionary.org/w/index.php?title=lequel&oldid=39771005", "https://en.wiktionary.org/w/index.php?title=lequel&oldid=90800439"]}
