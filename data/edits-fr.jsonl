{"id": "fr:au-dessus", "by": "claude", "added": "2026-11-27", "add_blocks": [{"pos": "adv", "pos_vi": "Phó từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Ở trên, phía trên (au-dessus de).", "sub": [], "tags": [], "examples": [{"src": "C'est au-dessus de Tilamook dans l'Oregon.", "tr": "Nó đang ở phía trên Tilamook, bang Oregon."}]}, {"gloss": "Trên, hơn (về số lượng, giá trị, địa vị).", "sub": [], "tags": [], "examples": [{"src": "Il est au-dessus de tous par son mérite.", "tr": "Anh ấy hơn mọi người về tài năng."}]}, {"gloss": "Vượt lên trên, không bận tâm đến.", "sub": [], "tags": [], "examples": [{"src": "Être au-dessus des événements.", "tr": "Đứng trên mọi biến cố."}, {"src": "Je pense qu'Apple est au-dessus de ça.", "tr": "Tôi nghĩ Apple vượt lên trên chuyện đó."}]}]}], "reason": "Le Wiktionnaire vietnamien n'a pas de page pour « au-dessus ».", "sources": ["https://fr.wiktionary.org/w/index.php?title=au-dessus&oldid=39959391", "https://en.wiktionary.org/w/index.php?title=au-dessus&oldid=86481556"]}
