{"id": "fr:tel", "by": "claude", "added": "2026-11-27", "add_blocks": [{"pos": "adj", "pos_vi": "Tính từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Như thế, như vậy.", "sub": [], "tags": [], "examples": [{"src": "Je n'ai jamais rien vu de tel.", "tr": "Tôi chưa từng thấy điều gì như thế."}, {"src": "Voici l'exemple d'un tel texte.", "tr": "Dưới đây là ví dụ về một văn bản như vậy."}]}, {"gloss": "Đó là, ấy là (đầu câu, chỉ điều vừa nói).", "sub": [], "tags": [], "examples": [{"src": "Tel fut notre défi.", "tr": "Đó là thử thách của chúng tôi."}, {"src": "Être, ou ne pas être : telle est la question.", "tr": "Tồn tại hay không tồn tại: đó là câu hỏi."}]}, {"gloss": "Lớn đến thế, đến mức (un tel…; tel… que).", "sub": [], "tags": [], "examples": [{"src": "C'est un tel honneur pour moi.", "tr": "Đó là một vinh dự lớn đến thế đối với tôi."}]}, {"gloss": "Như, giống như (so sánh).", "sub": [], "tags": [], "examples": [{"src": "Il fond sur elle tel un oiseau de proie.", "tr": "Hắn lao vào cô như một con chim săn mồi."}, {"src": "Tel père, tel fils.", "tr": "Cha nào con nấy."}]}, {"gloss": "Chẳng hạn như (nêu ví dụ).", "sub": [], "tags": [], "examples": [{"src": "Ottawa compte aussi de charmantes tables, tel le Fraser Café.", "tr": "Ottawa cũng có những nhà hàng dễ thương, chẳng hạn như Fraser Café."}]}, {"gloss": "Nào đó, này nọ (không xác định).", "sub": [], "tags": [], "examples": [{"src": "Il est allé s'établir dans telle ville.", "tr": "Anh ta đến định cư ở một thành phố nào đó."}]}]}, {"pos": "noun", "pos_vi": "Danh từ", "gloss_lang": "vi", "by": "claude", "tags": ["familier"], "senses": [{"gloss": "Điện thoại (viết tắt của téléphone).", "sub": [], "tags": [], "examples": [{"src": "Mon tel a été volé.", "tr": "Điện thoại của tôi bị mất cắp."}]}]}], "reason": "Le Wiktionnaire vietnamien n'a pas de page pour « tel ».", "sources": ["https://fr.wiktionary.org/w/index.php?title=tel&oldid=39812663", "https://en.wiktionary.org/w/index.php?title=tel&oldid=95717286"]}
