{"id": "fr:sou", "by": "claude", "added": "2026-11-27", "add_blocks": [{"pos": "noun", "pos_vi": "Danh từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Tiền, đồng xu (thường ở số nhiều: des sous; sans le sou: không một xu dính túi).", "sub": [], "tags": ["familier"], "examples": [{"src": "Nous étions sans le sou.", "tr": "Chúng tôi không một xu dính túi."}, {"src": "Tu peux me prêter des sous ?", "tr": "Cậu cho tớ vay ít tiền được không?"}]}, {"gloss": "Đồng xu (tiền cũ của Pháp, bằng năm xăng-tim).", "sub": [], "tags": [], "examples": [{"src": "Tu n'auras bientôt plus un sou.", "tr": "Chẳng mấy chốc bạn sẽ không còn một xu."}]}, {"gloss": "Xu, cent (một phần trăm đô la, ở Canada).", "sub": [], "tags": [], "examples": [{"src": "Ça va être six piastres et vingt-cinq sous, s'il te plaît.", "tr": "Hết sáu đô hai mươi lăm xu nhé."}]}]}], "reason": "Le Wiktionnaire vietnamien n'a pas de page pour « sou ».", "sources": ["https://fr.wiktionary.org/w/index.php?title=sou&oldid=39759381", "https://en.wiktionary.org/w/index.php?title=sou&oldid=93108421"]}
{"id": "fr:flotter", "by": "claude", "added": "2026-11-27", "add_blocks": [{"pos": "verb", "pos_vi": "Động từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Nổi (trên mặt nước), trôi nổi.", "sub": [], "tags": [], "examples": [{"src": "Parfois, j'ai vu des corps flotter dans le fleuve.", "tr": "Đôi khi tôi thấy xác người nổi trên sông."}]}, {"gloss": "Bay phấp phới, tung bay (cờ…).", "sub": [], "tags": [], "examples": [{"src": "Dans le port flottaient les pavillons de toutes les nations.", "tr": "Trong cảng tung bay cờ của mọi quốc gia."}]}, {"gloss": "Lơ lửng, bồng bềnh (trong không khí).", "sub": [], "tags": [], "examples": [{"src": "Car je suis là à flotter autour de ma boîte de conserve.", "tr": "Vì tôi đang lơ lửng quanh cái hộp thiếc của mình."}]}, {"gloss": "Rộng thùng thình (mặc quần áo quá rộng).", "sub": [], "tags": [], "examples": [{"src": "l'homme au visage émacié flotte dans ses habits", "tr": "người đàn ông mặt hốc hác mặc quần áo rộng thùng thình"}]}, {"gloss": "Thoáng hiện (nụ cười, nét mặt).", "sub": [], "tags": [], "examples": [{"src": "Un mince sourire flottait sur son visage.", "tr": "Một nụ cười mỏng thoáng hiện trên mặt bà."}]}, {"gloss": "Mưa.", "sub": [], "tags": ["familier"], "examples": [{"src": "Il a flotté toute la journée.", "tr": "Trời mưa suốt ngày."}]}]}], "reason": "Le Wiktionnaire vietnamien n'a pas de page pour « flotter ».", "sources": ["https://fr.wiktionary.org/w/index.php?title=flotter&oldid=39926693", "https://en.wiktionary.org/w/index.php?title=flotter&oldid=95807257"]}
{"id": "fr:allure", "by": "claude", "added": "2026-11-27", "add_blocks": [{"pos": "noun", "pos_vi": "Danh từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Tốc độ (à toute allure, à vive allure: rất nhanh).", "sub": [], "tags": [], "examples": [{"src": "La voiture s'est sauvée à toute allure.", "tr": "Chiếc xe phóng đi rất nhanh."}, {"src": "Donc ce défi avance à vive allure.", "tr": "Vậy là thử thách này đang tiến triển nhanh chóng."}]}, {"gloss": "Dáng vẻ, vẻ ngoài, phong thái (avoir de l'allure: trông sang, có phong cách).", "sub": [], "tags": [], "examples": [{"src": "Les professeurs avaient bonne allure.", "tr": "Các giáo viên trông rất ra dáng."}, {"src": "Elle doit avoir meilleure allure maintenant.", "tr": "Giờ chắc nó trông đẹp hơn rồi."}]}, {"gloss": "Dáng đi, cách đi.", "sub": [], "tags": [], "examples": [{"src": "Ce n'est pas à cette allure que vont jamais les gentlemen.", "tr": "Các quý ông chẳng bao giờ đi theo kiểu ấy."}]}, {"gloss": "Nước đi (của ngựa: đi bước, nước kiệu, phi).", "sub": [], "tags": [], "examples": [{"src": "Ses allures sont le pas et le galop.", "tr": "Nước đi của nó là đi bước và phi."}]}]}], "reason": "Le Wiktionnaire vietnamien n'a pas de page pour « allure ».", "sources": ["https://fr.wiktionary.org/w/index.php?title=allure&oldid=39981915", "https://en.wiktionary.org/w/index.php?title=allure&oldid=90670634"]}
{"id": "fr:loup", "by": "claude", "added": "2026-11-27", "add_blocks": [{"pos": "noun", "pos_vi": "Danh từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Chó sói, sói.", "sub": [], "tags": [], "examples": [{"src": "Après tout le loup, est un animal très coopératif.", "tr": "Xét cho cùng, sói là loài vật rất biết hợp tác."}, {"src": "Ou l'homme est-il un loup pour l'homme ?", "tr": "Hay người là sói đối với người?"}]}, {"gloss": "Cưng, cục cưng (tiếng gọi âu yếm: mon petit loup).", "sub": [], "tags": ["familier"], "examples": [{"src": "des mon petit loup et des mon gros canard sans fin", "tr": "những tiếng « cục cưng » và « bé yêu » không dứt"}]}, {"gloss": "Cá vược (loup de mer).", "sub": [], "tags": [], "examples": []}, {"gloss": "Mặt nạ che mắt (đeo trong dạ hội hóa trang).", "sub": [], "tags": [], "examples": [{"src": "Cette jeune femme avait le visage couvert d'un loup de velours noir.", "tr": "Người phụ nữ trẻ ấy che mặt bằng chiếc mặt nạ nhung đen."}]}, {"gloss": "Trò đuổi bắt (jouer au loup).", "sub": [], "tags": [], "examples": [{"src": "Mais je veux jouer au loup.", "tr": "Nhưng con muốn chơi đuổi bắt."}]}]}], "reason": "Le Wiktionnaire vietnamien n'a pas de page pour « loup ».", "sources": ["https://fr.wiktionary.org/w/index.php?title=loup&oldid=39954768", "https://en.wiktionary.org/w/index.php?title=loup&oldid=90588925"]}
