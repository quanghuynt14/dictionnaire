{"id": "fr:puisque", "by": "claude", "added": "2026-11-27", "add_blocks": [{"pos": "conj", "pos_vi": "Liên từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Vì, bởi vì, đã… thì (nêu lý do đã biết).", "sub": [], "tags": [], "examples": [{"src": "Puisque c'est rentable, cela ne va qu'empirer.", "tr": "Vì việc này sinh lời nên nó sẽ chỉ tệ hơn."}, {"src": "Puisqu'il ne sera pas de retour avant cinq heures, je propose que nous commencions sans lui.", "tr": "Vì anh ấy sẽ không về trước năm giờ, tôi đề nghị chúng ta bắt đầu mà không chờ anh ấy."}]}, {"gloss": "Đã bảo mà (trong câu cảm thán).", "sub": [], "tags": [], "examples": [{"src": "Puisque je vous le dis !", "tr": "Tôi đã bảo anh rồi mà!"}]}]}], "reason": "Le Wiktionnaire vietnamien n'a pas de page pour « puisque ».", "sources": ["https://fr.wiktionary.org/w/index.php?title=puisque&oldid=39771019", "https://en.wiktionary.org/w/index.php?title=puisque&oldid=93745754"]}
