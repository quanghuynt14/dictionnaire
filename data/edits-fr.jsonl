{"id": "fr:difficile", "by": "claude", "added": "2026-11-27", "add_blocks": [{"pos": "adj", "pos_vi": "Tính từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Khó, khó khăn, gian nan.", "sub": [], "tags": [], "examples": [{"src": "C'est une lutte très difficile.", "tr": "Đó là một trận chiến rất khó khăn."}, {"src": "Cela s'est avéré être une tâche difficile.", "tr": "Hóa ra đó là một nhiệm vụ khó khăn."}]}, {"gloss": "Khó tính, khó chiều, kén chọn (người).", "sub": [], "tags": [], "examples": [{"src": "un capitaine au caractère difficile", "tr": "một thuyền trưởng tính khí khó chiều"}]}, {"gloss": "Khó mà, khó có thể (ít khả năng xảy ra).", "sub": [], "tags": [], "examples": [{"src": "Il sera difficile de trouver une fillette qui joue convenablement avec vous.", "tr": "Sẽ khó tìm được một cô bé diễn ăn ý với ông."}]}]}, {"pos": "noun", "pos_vi": "Danh từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Người khó tính, người kén chọn.", "sub": [], "tags": [], "examples": [{"src": "Faire le difficile.", "tr": "Làm bộ khó tính."}]}]}], "reason": "Le Wiktionnaire vietnamien n'a pas de page pour « difficile ».", "sources": ["https://fr.wiktionary.org/w/index.php?title=difficile&oldid=40000075", "https://en.wiktionary.org/w/index.php?title=difficile&oldid=95808965"]}
{"id": "fr:gentil", "by": "claude", "added": "2026-11-27", "add_blocks": [{"pos": "adj", "pos_vi": "Tính từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Tử tế, tốt bụng, dễ mến.", "sub": [], "tags": [], "examples": [{"src": "Il est très gentil.", "tr": "Ông ấy rất tử tế."}, {"src": "Tout le monde n'est pas si gentil.", "tr": "Không phải ai cũng tốt như vậy."}]}, {"gloss": "Ngoan (trẻ em).", "sub": [], "tags": [], "examples": [{"src": "Les enfants ont été gentils, ce soir.", "tr": "Tối nay bọn trẻ ngoan."}]}, {"gloss": "Xinh xắn, dễ thương.", "sub": [], "tags": [], "examples": [{"src": "une gentille petite souris grise", "tr": "một chú chuột xám nhỏ xinh xắn"}]}, {"gloss": "Kha khá, đáng kể (số tiền).", "sub": [], "tags": [], "examples": [{"src": "C'est une gentille somme d'argent.", "tr": "Đó là một khoản tiền kha khá."}]}]}, {"pos": "noun", "pos_vi": "Danh từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Người tốt (nhân vật thiện, đối lập với kẻ xấu trong truyện, phim).", "sub": [], "tags": [], "examples": [{"src": "l'opposition entre les gentils et les méchants", "tr": "sự đối lập giữa người tốt và kẻ xấu"}]}, {"gloss": "Dân ngoại (người không phải Do Thái, trong Kinh Thánh).", "sub": [], "tags": [], "examples": [{"src": "Saint Paul est appelé « l'apôtre des gentils ».", "tr": "Thánh Phaolô được gọi là « tông đồ dân ngoại »."}]}]}], "reason": "Le Wiktionnaire vietnamien n'a pas de page pour « gentil ».", "sources": ["https://fr.wiktionary.org/w/index.php?title=gentil&oldid=39819260", "https://en.wiktionary.org/w/index.php?title=gentil&oldid=93079239"]}
{"id": "fr:sinon", "by": "claude", "added": "2026-11-27", "add_blocks": [{"pos": "conj", "pos_vi": "Liên từ", "gloss_lang": "vi", "by": "claude", "tags": [], "senses": [{"gloss": "Nếu không, không thì, kẻo.", "sub": [], "tags": [], "examples": [{"src": "Bien sûr que non, sinon je ne serais pas là.", "tr": "Tất nhiên là không, nếu không thì tôi đã chẳng ở đây."}, {"src": "Sinon cela fausserait tout.", "tr": "Nếu không thì mọi thứ sẽ bị sai lệch."}]}, {"gloss": "Nếu không nói là, thậm chí (nâng mức ước lượng).", "sub": [], "tags": [], "examples": [{"src": "Il m'en resterait au moins une centaine, sinon plus.", "tr": "Tôi vẫn còn ít nhất một trăm cuốn, nếu không nói là hơn."}]}, {"gloss": "Ngoài, trừ (ra).", "sub": [], "tags": [], "examples": [{"src": "Je ne sais pas grand-chose, sinon que je t'aime.", "tr": "Anh chẳng biết gì nhiều, ngoài việc anh yêu em."}]}]}], "reason": "Le Wiktionnaire vietnamien n'a pas de page pour « sinon ».", "sources": ["https://fr.wiktionary.org/w/index.php?title=sinon&oldid=39770943", "https://en.wiktionary.org/w/index.php?title=sinon&oldid=93566655"]}
